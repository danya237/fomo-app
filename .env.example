# FOMO v2.0 Environment Configuration
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to git - it contains secrets

# ============================================
# FIREBASE CONFIGURATION (required for v2.0)
# Get from: https://console.firebase.google.com
# 1. Create new project
# 2. Go to Project Settings
# 3. Copy config values below
# ============================================
EXPO_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# ============================================
# EXTERNAL APIs
# ============================================

# TMDb API (for movie metadata)
# Get from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=75d9423bc0ffb12337dfdfad7f61bf9a

# YouTube Data API v3 (for shorts search - v2.0)
# Get from: https://console.cloud.google.com
# 1. Create project
# 2. Enable YouTube Data API v3
# 3. Create API key (restrict to mobile/web apps)
EXPO_PUBLIC_YOUTUBE_API_KEY=AIzaSy...YOUR_YOUTUBE_API_KEY

# ============================================
# CLOUD FUNCTIONS (optional - for sync job)
# ============================================
MANUAL_SYNC_API_KEY=your-secret-sync-key

# ============================================
# DEPLOYMENT (optional)
# ============================================
# Expo Application Services (EAS)
# Get from: https://expo.dev
EXPO_EAS_TOKEN=your-eas-token

# ============================================
# NOTES
# ============================================
# - EXPO_PUBLIC_* vars are exposed to client (safe to use)
# - Never commit secrets like API keys to git
# - For testing, you can use Firebase Emulator Suite
# - YouTube API has 10K daily quota (free tier)

