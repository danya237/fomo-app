# MovieSwipe Environment Variables
# Copy this file to .env and fill in your actual values

# TMDb API Key
# Get it from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Firebase Configuration (for future use)
# Get it from: https://console.firebase.google.com/
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abcdef

# Other APIs (optional, for future features)
# STREAMING_API_KEY=your_streaming_api_key
